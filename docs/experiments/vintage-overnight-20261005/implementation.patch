+"""Focused checks for label contamination, input scope and archive donor leakage."""
+import json
+from pathlib import Path
+from dataclasses import replace
+import numpy as np
+import pandas as pd
+from tapestry.model.scenario import Scenario
+from tapestry.dataset.build import load, covariate_names_for
+from tapestry.dataset import cv
+from tapestry.dataset.vintage_overnight import VintageOvernight
+from tapestry.dataset.episodes import episodes
+panel=load(json.loads(Path('data/experiments/b-2-t0/experiment.json').read_text())['dataset'])
+base=Scenario.from_string(pd.read_csv('docs/experiments/b-2-t0/named_ranking.csv').iloc[1].config_id)
+base=replace(base,weekend_family='direct',supplied_final=False,mask_rate=0,reporting_missingness=False,reporting_augmentation='vintage',vintage_scope='early_actual',vintage_signals='admissions',reporting_strength=.5)
+for heldout in base.scored_seasons:
+ keep=np.isin(cv.week_roles(panel['dates'],base,heldout),['fit','validation'])
+ es=episodes(cv.masked(panel,keep),base.lookback,'scheduled_final',list(covariate_names_for(base.covariate_set)))
+ for generator in ['empirical','ridge']:
+  bank=VintageOvernight(panel,replace(base,vintage_generator=generator),heldout,keep)
+  assert bank.donor_season==('2025-2026' if heldout=='2024-2025' else '2024-2025')
+  assert all(cv.season(d)==bank.donor_season for d in bank.donors)
+  for season in ['2022-2023','2023-2024',bank.donor_season]:
+   e=next(e for e in es if cv.season(e['context_dates'][-1])==season and e['available'][-1].any())
+   before={k:v.copy() for k,v in e.items() if isinstance(v,np.ndarray)}
+   out=bank.draw(e,np.random.default_rng(42))
+   for key in ['target_values','target_available','Y']:
+    np.testing.assert_array_equal(out[key],before[key])
+   for key,arr in before.items():np.testing.assert_array_equal(e[key],arr)
+   if season in ['2022-2023','2023-2024']:
+    np.testing.assert_array_equal(out['values'][:,3:],before['values'][:,3:])
+    np.testing.assert_array_equal(out['covariates'],before['covariates'])
+   assert np.all(np.isfinite(out['values'])) and np.all(out['values']>=0)
+  print('PASS',heldout,generator,flush=True)

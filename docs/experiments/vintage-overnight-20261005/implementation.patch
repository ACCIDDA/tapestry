@@ -0,0 +1,34 @@
+"""Temporarily prioritize unstarted matched controls, then restore all other work."""
+import json
+import time
+from pathlib import Path
+from tapestry.experiment.dispatch import queue_lock
+from tapestry.experiment.provenance import save
+f=Path('data/experiments/vintage-overnight-round1-20261005')
+controls={'0','10','20'}
+with queue_lock(f):
+ s=json.loads((f/'dispatch.json').read_text())
+ held=[]
+ for task,e in s['tasks'].items():
+  if task in controls: continue
+  for seed,status in e['seeds'].items():
+   if status=='pending':
+    e['seeds'][seed]='waiting_for_control_claims'
+    held.append((task,seed))
+ save(f/'dispatch.json',s)
+ save(f/'control-priority.json',dict(held=held,status='waiting for control claims',planned_seeds_unchanged=True))
+print(f'Temporarily holding {len(held)} unstarted noncontrol fits.',flush=True)
+while True:
+ with queue_lock(f):
+  s=json.loads((f/'dispatch.json').read_text())
+  pending=[(task,seed) for task in controls for seed,status in s['tasks'][task]['seeds'].items() if status=='pending']
+  if not pending:
+   restored=0
+   for task,seed in held:
+    if s['tasks'][task]['seeds'].get(seed)=='waiting_for_control_claims':
+     s['tasks'][task]['seeds'][seed]='pending';restored+=1
+   save(f/'dispatch.json',s)
+   save(f/'control-priority.json',dict(held=held,status='released after all controls claimed',restored=restored,planned_seeds_unchanged=True))
+   print(f'Controls claimed; restored {restored} pending fits.',flush=True)
+   break
+ time.sleep(10)

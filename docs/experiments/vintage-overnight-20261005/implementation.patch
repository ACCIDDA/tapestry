+"""Compare effective input perturbations to observed donor error magnitudes."""
+import json
+from pathlib import Path
+from dataclasses import replace
+import numpy as np
+import pandas as pd
+from tapestry.model.scenario import Scenario
+from tapestry.dataset.build import load
+from tapestry.dataset import cv
+from tapestry.dataset.vintage_overnight import VintageOvernight
+from tapestry.dataset.episodes import episodes
+settings=json.loads(Path('data/experiments/b-2-t0/experiment.json').read_text())
+panel=load(settings['dataset'])
+base=Scenario.from_string(pd.read_csv('docs/experiments/b-2-t0/named_ranking.csv').iloc[0].config_id)
+base=replace(base,weekend_family='direct',supplied_final=False,mask_rate=0,reporting_missingness=False,reporting_augmentation='vintage',vintage_scope='all')
+rows=[]
+def record(values,source,heldout,season,signal,age):
+ x=np.asarray(values)
+ rows.append(dict(heldout_forecast_season=heldout,reporting_error_training_season='2025-2026' if heldout=='2024-2025' else '2024-2025',input_season=season,source=source,signal=signal,report_age_weeks=age,cells=len(x),mean_log_error=x.mean(),rms_log_error=np.sqrt(np.mean(x*x)),zero_fraction=np.mean(np.abs(x)<1e-7),p05=np.quantile(x,.05),p95=np.quantile(x,.95)))
+for heldout in base.scored_seasons:
+ keep=np.isin(cv.week_roles(panel['dates'],base,heldout),['fit','validation'])
+ es=list(episodes(cv.masked(panel,keep),base.lookback,'scheduled_final',[]))
+ for gen,strength in [('empirical',1.),('empirical',.5),('ridge',1.),('ridge',.5)]:
+  bank=VintageOvernight(panel,replace(base,vintage_generator=gen,reporting_strength=strength),heldout,keep)
+  if gen=='empirical' and strength==1:
+   for age in [0,3]:
+    j=base.lookback-1-age
+    for c,signal in enumerate(panel['target_names']):
+     ok=bank.support[:,j,c]&bank.visible[:,j,c]
+     record(bank.errors[:,j,c][ok],'Observed archived/final pairs',heldout,bank.donor_season,signal,age)
+  rng=np.random.default_rng(20261005)
+  samples={}
+  for e in es:
+   season=cv.season(e['context_dates'][-1])
+   if season not in bank.peaks:continue
+   for replicate in range(5):
+    changed=bank.draw(e,rng)
+    floor=bank.target_floor(e)
+    error=np.log((changed['values']+floor)/(e['values']+floor))
+    for age in [0,3]:
+     j=base.lookback-1-age
+     for c,signal in enumerate(panel['target_names']):
+      ok=e['available'][j,c]
+      samples.setdefault((season,signal,age),[]).extend(error[j,c,ok])
+  for (season,signal,age),values in samples.items():
+   if values:record(values,f'{gen} strength {strength:g}',heldout,season,signal,age)
+out=Path('docs/experiments/vintage-overnight-20261005/transport-error-magnitudes.csv')
+pd.DataFrame(rows).to_csv(out,index=False)
+print(out)
+import matplotlib
+matplotlib.use('Agg')
+import matplotlib.pyplot as plt
+frame=pd.DataFrame(rows)
+part=frame[(frame.heldout_forecast_season=='2025-2026')&(frame.input_season=='2022-2023')&(frame.report_age_weeks==0)&frame.source.isin(['empirical strength 1','ridge strength 1'])]
+fig,axes=plt.subplots(1,2,figsize=(12,5))
+for ax,value,title in zip(axes,['rms_log_error','zero_fraction'],['RMS effective log perturbation','Fraction of available values unchanged']):
+ grid=part.pivot(index='signal',columns='source',values=value)
+ grid.index=[x.replace('nhsn_','').replace('nssp_','').replace('_',' ') for x in grid.index]
+ grid.rename(columns={'empirical strength 1':'Empirical donor windows','ridge strength 1':'Learned mean + donor residuals'}).plot.bar(ax=ax,rot=30)
+ ax.set_title(title);ax.set_xlabel('');ax.grid(axis='y',alpha=.2)
+fig.suptitle('Artificial reporting errors applied to finalized 2022–23 training inputs\nBoth generators learned only from 2024–25; current-week values, five draws per origin; first-round pinned code',fontsize=11)
+fig.text(.02,.01,'Input diagnostic only: no forecast retraining or scoring. Unchanged future labels. RSV admissions absent in 2022–23 and therefore omitted.',fontsize=8)
+fig.tight_layout(rect=[0,.04,1,1])
+fig.savefig(out.with_suffix('.png'),dpi=180)
+fig.savefig(out.with_suffix('.pdf'))

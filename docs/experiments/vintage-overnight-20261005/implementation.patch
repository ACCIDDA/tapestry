+"""One dated, guarded handoff to avoid an allocation timeout; not a general launcher."""
+import json,subprocess,time
+from pathlib import Path
+from tapestry.experiment.dispatch import queue_lock
+from tapestry.experiment.provenance import save
+folder=Path('data/experiments/vintage-overnight-admissions-focused-20261005')
+node='g1803jles01';child=293756;parents=[291089,291341]
+def signal(kind,pids):subprocess.run(['ssh',node,'kill',kind,*map(str,pids)],check=True)
+command=subprocess.check_output(['ssh',node,'ps','-p',str(child),'-o','args='],text=True)
+assert 'mlp-target-scheduled_final-bf59e0a4e9c9/s44/attempt-001' in command,command
+with queue_lock(folder):
+ state=json.loads((folder/'dispatch.json').read_text())
+ assert state['tasks']['10']['active']['44']['owner']=='3804709_0'
+record=dict(task='10',seed=44,old_owner='3804709_0',old_process=child,reason='Started06:37 on allocation ending07:35; matching seed took63.5minutes; reroute to owners ending07:58',started=time.time())
+save(folder/'reroute-record.json',record)
+signal('-TERM',[child])
+print('Stopped only the newly started C3 learned-admissions seed44 fit.',flush=True)
+stop=time.time()+60
+while time.time()<stop:
+ with queue_lock(folder):state=json.loads((folder/'dispatch.json').read_text())
+ if state['tasks']['10']['seeds']['44']=='failed' and sum(a['owner']=='3804709_0' for t in state['tasks'].values() for a in t['active'].values())==4:break
+ time.sleep(1)
+else:raise RuntimeError('Dispatcher did not finish the stopped fit and claim replacement work')
+paused=[];held=[]
+try:
+ for pid in parents:
+  signal('-STOP',[pid]);paused.append(pid)
+ # Only queue managers pause. Their independent training children keep running.
+ with queue_lock(folder):
+  state=json.loads((folder/'dispatch.json').read_text())
+  for task,entry in state['tasks'].items():
+   for seed,status in entry['seeds'].items():
+    if status=='pending':entry['seeds'][seed]='held_for_reroute';held.append((task,seed))
+  state['tasks']['10']['seeds']['44']='pending'
+  save(folder/'dispatch.json',state)
+ print('Earlier-ending queue managers paused; existing training children continue.',flush=True)
+ until=time.time()+8*60
+ while time.time()<until:
+  with queue_lock(folder):state=json.loads((folder/'dispatch.json').read_text())
+  active=state['tasks']['10']['active'].get('44')
+  if active:
+   assert active['owner'] in ['3804709_2','3804709_3'],active
+   record.update(new_owner=active['owner'],restarted=time.time(),status='rerouted')
+   print('Restarted seed44 on',active['owner'],flush=True)
+   break
+  time.sleep(3)
+ else:raise RuntimeError('No later-ending allocation claimed the fit within eight minutes')
+finally:
+ with queue_lock(folder):
+  state=json.loads((folder/'dispatch.json').read_text())
+  for task,seed in held:
+   if state['tasks'][task]['seeds'].get(seed)=='held_for_reroute':state['tasks'][task]['seeds'][seed]='pending'
+  save(folder/'dispatch.json',state)
+ for pid in paused:signal('-CONT',[pid])
+ record['managers_resumed']=time.time();save(folder/'reroute-record.json',record)
+ print('Queue managers resumed; unchanged pending work restored.',flush=True)

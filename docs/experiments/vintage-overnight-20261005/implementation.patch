+"""Focused C1/C2/C3 synthetic reporting comparison, through common planner."""
+import argparse
+from dataclasses import replace
+import json
+from pathlib import Path
+import subprocess
+import sys
+import pandas as pd
+from tapestry.model.scenario import Scenario
+
+p=argparse.ArgumentParser()
+p.add_argument('-e','--experiment',required=True)
+p.add_argument('--smoke',action='store_true')
+p.add_argument('--admissions',action='store_true')
+p.add_argument('--diluted',action='store_true',help='One C1 half-clean, half-strength empirical comparison')
+a=p.parse_args()
+base=pd.read_csv('docs/experiments/b-2-t0/named_ranking.csv').head(3)
+arms=[('Finalized training inputs',dict(reporting_probability=0.)),
+      ('Empirical half-strength, all three training seasons',dict(reporting_strength=.5)),
+      ('Empirical full-strength, all three training seasons',dict()),
+      ('Empirical half-strength early two; recent finalized',dict(vintage_scope='early_clean',reporting_strength=.5)),
+      ('Empirical full-strength early two; recent finalized',dict(vintage_scope='early_clean')),
+      ('Empirical half-strength early two; recent actual reports',dict(vintage_scope='early_actual',reporting_strength=.5)),
+      ('Empirical full-strength early two; recent actual reports',dict(vintage_scope='early_actual')),
+      ('Learned conditional mean and residual early two; recent actual reports',dict(vintage_scope='early_actual',vintage_generator='ridge')),
+      ('Learned conditional mean only early two; recent actual reports',dict(vintage_scope='early_actual',vintage_generator='ridge',vintage_residual=0.)),
+      ('Learned conditional mean and residual all three',dict(vintage_generator='ridge'))]
+if a.admissions:
+    arms=[('Finalized early two; actual recent reports',dict(vintage_scope='early_actual',reporting_probability=0.)),
+          ('Empirical half-strength admissions early two; actual recent reports',dict(vintage_scope='early_actual',vintage_signals='admissions',reporting_strength=.5)),
+          ('Learned half-strength admissions early two; actual recent reports',dict(vintage_scope='early_actual',vintage_signals='admissions',vintage_generator='ridge',reporting_strength=.5)),
+          ('Empirical half-strength admissions all three; ED and covariates finalized',dict(vintage_signals='admissions',reporting_strength=.5))]
+if a.diluted:
+    base=base.head(1)
+    arms=[('Half-clean episodes; half-strength empirical errors all three',dict(reporting_probability=.5,reporting_strength=.5))]
+rows=[]
+for row in base.itertuples():
+    original=Scenario.from_string(row.config_id)
+    for label,kw in arms:
+        scenario=replace(original,supplied_final=False,mask_rate=0.,reporting_missingness=False,
+                         reporting_augmentation='vintage',weekend_family='direct',**kw)
+        if a.smoke:
+            if row.label != 'C1' or scenario.vintage_generator != 'ridge': continue
+            scenario=replace(scenario,epochs=2,patience=0,members=8,validation_members=16)
+        rows.append(dict(architecture=row.label,treatment=label,run_id=scenario.run_id,scenario=scenario.scenario_string))
+settings=json.loads(Path('data/experiments/b-2-t0/experiment.json').read_text())
+cmd=[sys.executable,'-m','tapestry.experiment.planner','plan','-e',a.experiment,'-s',*[r['scenario'] for r in rows],
+     '--seeds',*(['42'] if a.smoke else ['42','43','44']),'--device','cuda','--eval-members','256',
+     '--dataset',settings['dataset'],'--frozen',settings['frozen']]
+subprocess.run(cmd,check=True)
+folder=Path('data/experiments')/a.experiment
+pd.DataFrame(rows).to_csv(folder/'design.csv',index=False)
+(folder/'manager-plan.txt').write_text(' '.join(cmd)+'\n')
+print(f'{len(rows)} configurations planned')

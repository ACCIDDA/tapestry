+ path=folder/'seed-season-results.csv'
+ if path.exists():frames.append(pd.read_csv(path))
+f=pd.concat(frames,ignore_index=True).drop_duplicates(['config_id','seed','season'])
+reference='Finalized early two; actual recent reports'
+selected=summary[(summary.actual_recent_attribution_eligible)&(summary.forward_actual_recent_reference_seeds==3)].copy()
+selected.to_csv(root/'actual-recent-attribution.csv',index=False)
+lines=['# Contribution of artificial errors after recent-season actual inputs', '',
+'Every row retrains the named model with unchanged finalized t+1 through t+4 labels. Forward evaluation uses 2025–26 Wednesday reports after training on 2022–23/2023–24/2024–25. The reference uses finalized 2022–23/2023–24 inputs and actual 2024–25 reports. Treatments add artificial errors to those first two seasons, learned or sampled only from 2024–25. Retrospective evaluation swaps 2024–25 and 2025–26 in these roles. All use identical B2 source delays and frozen-final proxies where archives are absent. Forward scores cover six targets; retrospective scores cover flu/COVID admissions only. Lower relative WIS is better.', '',
+'C1: pathogen MLP, distance sharing, no covariates. C2: target MLP, no spatial sharing, inpatient/wastewater/Kinsa/ILINet/clinical-lab/FluSurv covariates. C3: target MLP, neighbor sharing, Kinsa.', '',
+'Only comparisons with all three treatment and reference seeds are shown. Percent changes are changes of three-seed means. The CSV also gives paired differences and seed variation.', '',
+'| Model | Additional training-input treatment in 2022–23/2023–24 | Forward change vs actual-recent-only | Improving seeds | Retrospective change vs actual-recent-only |',
+'| --- | --- | ---: | ---: | ---: |']
+for r in selected.itertuples():
+ if r.treatment==reference:continue
+ lines.append(f'| {r.architecture} | {r.treatment} | {r.forward_versus_actual_recent_percent_change_of_means:+.2f}% | {int(r.forward_versus_actual_recent_improving_seeds)}/3 | {r.retrospective_versus_actual_recent_percent_change_of_means:+.2f}% |')
+(root/'actual-recent-attribution.md').write_text('\n'.join(lines)+'\n')
+if selected.empty:
+ print('No three-seed actual-recent reference complete yet; attribution table withheld.')
+ raise SystemExit
+names={
+ 'Finalized training inputs':'Finalized inputs\nall three seasons',
+ reference:'Finalized early two;\nactual recent',
+ 'Empirical half-strength early two; recent actual reports':'Early two: empirical\nhalf, all signals',
+ 'Learned conditional mean only early two; recent actual reports':'Early two: learned\nmean, all signals',
+ 'Empirical half-strength admissions early two; actual recent reports':'Early two: empirical\nhalf, admissions',
+ 'Learned half-strength admissions early two; actual recent reports':'Early two: learned mean\n+ residual, half, admissions',
+}
+# Select treatment names from the design verbatim; missing arms are omitted.
+fig,axes=plt.subplots(1,3,figsize=(17,7),sharey=True)
+models={'C1':'Pathogen MLP; distance; no covariates','C2':'Target MLP; no spatial; six covariate groups','C3':'Target MLP; neighbors; Kinsa'}
+for ax,arch in zip(axes,['C1','C2','C3']):
+ rows=summary[(summary.architecture==arch)&summary.treatment.isin(names)]
+ if arch not in set(selected.architecture):
+  ax.text(.5,.5,'Three-seed actual-recent\nreference pending',ha='center',va='center',transform=ax.transAxes)
+  ax.set_title(arch+'\n'+models[arch],fontsize=10);continue
+ rows=rows.assign(order=rows.treatment.map({name:i for i,name in enumerate(names)})).sort_values('order')
+ for seed in [42,43,44]:
+  y=[]
+  for row in rows.itertuples():
+   values=f[(f.config_id==row.scenario)&(f.seed==seed)&(f.season=='2025-2026')]
+   y.append(float(values.iloc[0]['combined']))
+  ax.plot(range(len(rows)),y,marker='o',alpha=.45,lw=1,label=f'Seed {seed}')
+ ax.plot(range(len(rows)),rows.forward_mean.to_numpy(),color='black',marker='D',lw=2,label='Three-seed mean')
+ ax.set_xticks(range(len(rows)),[names[t] for t in rows.treatment],rotation=35,ha='right',fontsize=8)
+ ax.set_title(arch+'\n'+models[arch],fontsize=10)
+ ax.axhline(1,color='gray',ls=':',lw=1);ax.grid(axis='y',alpha=.2)
+axes[0].set_ylabel('2025–26 six-target relative WIS; lower is better')
+next(ax for ax in axes if ax.lines).legend(fontsize=8)
+fig.suptitle('Does artificial vintaging improve on using actual recent-season training reports?',fontsize=14)
+fig.text(.02,.035,'Each point retrains the model on 2022–23/2023–24/2024–25; finalized future labels unchanged. Artificial errors use only 2024–25 archived/final pairs.\nEvaluation: 2025–26 Wednesday reports, B2 source lags, frozen-final proxies where archives are absent. Same three seeds on L40; development comparison.\nC2 covariates: inpatient, wastewater, Kinsa, ILINet, clinical labs and FluSurv. Admission targets have twice ED weight; US20%, states/DC80%.',fontsize=10)
+fig.subplots_adjust(bottom=.34,top=.85,wspace=.12)
+fig.savefig(root/'actual-recent-attribution.png',dpi=170)
+fig.savefig(root/'actual-recent-attribution.pdf')

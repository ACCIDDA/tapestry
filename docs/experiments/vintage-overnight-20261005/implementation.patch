+import json
+from pathlib import Path
+import numpy as np
+import pandas as pd
+from tapestry.dataset.build import load
+from tapestry.dataset import cv
+s=json.loads(Path('data/experiments/b-2-t0/experiment.json').read_text())
+p=load(s['dataset'])
+rows=[]
+for ti,d in enumerate(p['dates']):
+ if cv.season(d) not in ('2024-2025','2025-2026'): continue
+ issuance=np.datetime64(d)+np.timedelta64(4,'D')
+ wi=np.searchsorted(p['issuance_dates'],issuance)
+ if wi>=len(p['issuance_dates']) or p['issuance_dates'][wi]!=issuance: continue
+ for k,name in enumerate(p['target_names']):
+  row=dict(date=str(d),season=cv.season(d),signal=name)
+  for age in (0,1,3): row[f'age{age}_locations']=int(np.isfinite(p['asof_targets'][wi,max(ti-age,0),:,k]).sum())
+  rows.append(row)
+out=Path('docs/experiments/vintage-overnight-20261005')
+pd.DataFrame(rows).to_csv(out/'archive-support-by-origin.csv',index=False)
+print(pd.DataFrame(rows).groupby(['season','signal']).agg({'age0_locations':['sum','count'],'age1_locations':'sum','age3_locations':'sum'}).to_string())

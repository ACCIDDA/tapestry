+"""Describe and temporally cross-validate permitted donor reporting-error models."""
+import json
+from pathlib import Path
+from dataclasses import replace
+import numpy as np
+import pandas as pd
+from tapestry.model.scenario import Scenario
+from tapestry.dataset.build import load
+from tapestry.dataset import cv
+from tapestry.dataset.vintage_overnight import VintageOvernight
+from tapestry.dataset.episodes import episodes
+
+out=Path('docs/experiments/vintage-overnight-20261005'); out.mkdir(parents=True,exist_ok=True)
+settings=json.loads(Path('data/experiments/b-2-t0/experiment.json').read_text())
+panel=load(settings['dataset'])
+base=Scenario.from_string(pd.read_csv('docs/experiments/b-2-t0/named_ranking.csv').iloc[0].config_id)
+s=replace(base,weekend_family='direct',supplied_final=False,mask_rate=0,reporting_missingness=False,reporting_augmentation='vintage')
+rows=[]
+for heldout in s.scored_seasons:
+ keep=np.isin(cv.week_roles(panel['dates'],s,heldout),['fit','validation'])
+ bank=VintageOvernight(panel,s,heldout,keep)
+ es={e['context_dates'][-1]:e for e in episodes(cv.masked(panel,keep),s.lookback,'scheduled_final',[])}
+ xs=np.stack([bank.features_for(es[d],'target') for d in bank.donors])
+ assignment=np.minimum(np.arange(len(bank.donors))*4//len(bank.donors),3)
+ for age in (0,1,2,3,5,7,11):
+  j=s.lookback-1-age
+  for channel,name in enumerate(panel['target_names']):
+   y=bank.errors[:,j,channel]
+   valid=bank.support[:,j,channel]&bank.visible[:,j,channel]
+   x=xs[:,j,channel]
+   predicted=np.zeros_like(y); global_pred=np.zeros_like(y)
+   for block in range(4):
+    train=valid&(assignment!=block)[:,None]
+    xx,yy=x[train],y[train]
+    penalty=np.eye(x.shape[-1])*20; penalty[0,0]=1e-4
+    b=np.linalg.solve(xx.T@xx+penalty,xx.T@yy)
+    test=assignment==block
+    predicted[test]=x[test]@b
+    global_pred[test]=yy.mean() if len(yy) else 0
+   rows.append(dict(heldout_forecast_season=heldout,reporting_error_training_season=bank.donor_season,
+    signal=name,report_age_weeks=age,n=int(valid.sum()),mean_log_error=float(y[valid].mean()),
+    rms_log_error=float(np.sqrt(np.mean(y[valid]**2))),

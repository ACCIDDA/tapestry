+"""Display the effect of scoring support using the same completed forecasts."""
+from pathlib import Path
+import numpy as np
+import pandas as pd
+import matplotlib
+matplotlib.use('Agg')
+import matplotlib.pyplot as plt
+root=Path('docs/experiments/vintage-overnight-20261005')
+folder=root/'vintage-overnight-admissions-focused-20261005'
+main=pd.read_csv(folder/'season-results.csv')
+shared=pd.read_csv(folder/'common-admission-season-results.csv')
+main=main[main.seeds==3];shared=shared[shared.seeds==3]
+treatments={
+ 'Finalized early two; actual recent reports':'Finalized early two; actual recent reports',
+ 'Empirical half-strength admissions early two; actual recent reports':'Empirical half-strength admissions in early two; actual recent reports',
+ 'Learned half-strength admissions early two; actual recent reports':'Learned mean + residual, half-strength admissions in early two; actual recent reports',
+ 'Empirical half-strength admissions all three; ED and covariates finalized':'Empirical half-strength admissions in all three; ED/covariates finalized',
+}
+rows=[]
+for arch in ['C1','C2','C3']:
+ for treatment,label in treatments.items():
+  a=main[(main.architecture==arch)&(main.treatment==treatment)&(main.evaluation_season=='2025-2026')]
+  b=shared[(shared.architecture==arch)&(shared.treatment==treatment)&(shared.season=='2025-2026')]
+  c=shared[(shared.architecture==arch)&(shared.treatment==treatment)&(shared.season=='2024-2025')]
+  if min(len(a),len(b),len(c))!=1:continue
+  rows.append(dict(architecture=arch,training_inputs=label,
+   retrospective_shared_admissions_percent_change=float(c.iloc[0].percent_difference_from_matched_control),
+   forward_shared_admissions_percent_change=float(b.iloc[0].percent_difference_from_matched_control),
+   forward_six_target_percent_change=float(a.iloc[0].percent_difference_from_matched_control)))
+f=pd.DataFrame(rows)
+f.to_csv(root/'shared-target-season-comparison.csv',index=False)
+fig,ax=plt.subplots(figsize=(13,8))
+columns=list(f.columns[2:]);values=f[columns].to_numpy()
+im=ax.imshow(values,cmap='RdBu_r',vmin=-15,vmax=15,aspect='auto')
+ax.set_yticks(range(len(f)),[r.architecture+': '+r.training_inputs for r in f.itertuples()],fontsize=9)
+ax.set_xticks(range(3),['Evaluate 2024–25\nFlu/COVID admissions\n(retrospective)','Evaluate 2025–26\nFlu/COVID admissions\n(secondary)','Evaluate 2025–26\nSix targets\n(primary)'],fontsize=10)
+for i in range(len(f)):
+ for j in range(3):ax.text(j,i,f'{values[i,j]:+.1f}%',ha='center',va='center',fontsize=10)
+for boundary in [3.5,7.5]:ax.axhline(boundary,color='white',lw=2)
+fig.suptitle('Training-input effects differ by season even on shared admission targets\nPercent change versus the same architecture trained on finalized inputs in all three seasons; three seeds; lower is better',fontsize=12)
+fig.text(.02,.025,'Each arm retrains on 2022–23/2023–24 plus 2025–26 for retrospective evaluation, or plus 2024–25 for forward evaluation.\nErrors use only that added season; early two means 2022–23/2023–24. Finalized future labels unchanged. Wednesday archived inputs, B2 lags and final proxies.\nC1: pathogen MLP, distance, no covariates. C3: target MLP, neighbors, Kinsa.\nC2: target MLP, no spatial; inpatient, wastewater, Kinsa, ILINet, clinical labs and FluSurv.\nThe two forward columns score the same forecasts: shared admissions receive equal weight; primary admissions have twice ED weight; US20%, states/DC80%.',fontsize=9)
+fig.subplots_adjust(left=.57,right=.89,bottom=.27,top=.86)
+cax=fig.add_axes([.91,.29,.015,.48]);fig.colorbar(im,cax=cax,label='Change versus finalized-input training (%)')
+fig.savefig(root/'shared-target-season-comparison.png',dpi=170,bbox_inches='tight')
+fig.savefig(root/'shared-target-season-comparison.pdf',bbox_inches='tight')
+print(f.to_string(index=False))

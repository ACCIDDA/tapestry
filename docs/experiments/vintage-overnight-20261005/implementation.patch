+++ b/scripts/vintage_overnight_narrow.py
@@ -0,0 +1,42 @@
+"""Keep seed-42 pilots for two weak full-strength arms; retain all other seeds.
+
+Run after the first-round manager plan and before launching, or while only the
+removed seeds are still unstarted. The common manager then resumes the narrowed
+78-run plan without restoring those replications.
+"""
+import argparse
+import json
+from pathlib import Path
+import pandas as pd
+from tapestry.experiment.dispatch import queue_lock
+from tapestry.experiment.planner import read_jobs, write_jobs
+from tapestry.experiment.provenance import save
+p=argparse.ArgumentParser();p.add_argument('-e','--experiment',required=True)
+a=p.parse_args();f=Path('data/experiments')/a.experiment
+select={'Empirical full-strength, all three training seasons','Empirical full-strength early two; recent finalized'}
+design=pd.read_csv(f/'design.csv')
+scenarios=set(design.loc[design.treatment.isin(select),'scenario'])
+if len(scenarios)!=6: raise ValueError('Expected these two treatments on C1/C2/C3')
+removed=[]
+with queue_lock(f):
+ state=json.loads((f/'dispatch.json').read_text()) if (f/'dispatch.json').exists() else None
+ jobs=read_jobs(f)
+ for job in jobs:
+  if job['scenario'] not in scenarios: continue
+  for seed in list(job['seeds']):
+   if seed==42: continue
+   entry=state['tasks'][str(job['task'])] if state else None
+   if entry and (str(seed) in entry['active'] or entry['seeds'].get(str(seed)) in ('running','complete')):
+    raise ValueError(f'Cannot remove started task {job["task"]} seed {seed}')
+   removed.append(dict(task=job['task'],seed=seed,scenario=job['scenario']))
+   job['seeds'].remove(seed)
+   if entry: entry['seeds'].pop(str(seed),None)
+ write_jobs(f,jobs)
+ if state: save(f/'dispatch.json',state)
+design['planned_seeds']=design.scenario.map({j['scenario']:' '.join(map(str,j['seeds'])) for j in jobs})
+design.to_csv(f/'design.csv',index=False)
+if removed or not (f/'narrowed-plan.json').exists():
+ save(f/'narrowed-plan.json',dict(seed_runs=sum(len(j['seeds']) for j in jobs),removed=removed,
+ reason='Prior weekend evidence and initial L40 pilots show forward harm from blanket full-strength errors; reserve time for admissions-specific follow-up.',
+ resume='Ordinary common-manager status/resubmission now preserves this narrowed jobs.csv. No started fits removed.'))
+print(f'Narrowed plan: {sum(len(j["seeds"]) for j in jobs)} seed runs; removed {len(removed)} unstarted replications.')
diff --git a/scripts/vintage_overnight_nonlinear_diagnostics.py b/scripts/vintage_overnight_nonlinear_diagnostics.py
new file mode 100644
--- /dev/null
+++ b/scripts/vintage_overnight_nonlinear_diagnostics.py
@@ -0,0 +1,74 @@
+"""Describe and temporally cross-validate permitted donor reporting-error models."""
+import json
+from pathlib import Path
+from dataclasses import replace
+import numpy as np
+import pandas as pd
+from sklearn.ensemble import HistGradientBoostingRegressor
+from tapestry.model.scenario import Scenario
+from tapestry.dataset.build import load
+from tapestry.dataset import cv
+from tapestry.dataset.vintage_overnight import VintageOvernight
+from tapestry.dataset.episodes import episodes
+
+out=Path('docs/experiments/vintage-overnight-20261005'); out.mkdir(parents=True,exist_ok=True)
+settings=json.loads(Path('data/experiments/b-2-t0/experiment.json').read_text())
+panel=load(settings['dataset'])
+base=Scenario.from_string(pd.read_csv('docs/experiments/b-2-t0/named_ranking.csv').iloc[0].config_id)
+s=replace(base,weekend_family='direct',supplied_final=False,mask_rate=0,reporting_missingness=False,reporting_augmentation='vintage')
+rows=[]
+for heldout in s.scored_seasons:
+ keep=np.isin(cv.week_roles(panel['dates'],s,heldout),['fit','validation'])
+ bank=VintageOvernight(panel,s,heldout,keep)
+ es={e['context_dates'][-1]:e for e in episodes(cv.masked(panel,keep),s.lookback,'scheduled_final',[])}
+ xs=np.stack([bank.features_for(es[d],'target') for d in bank.donors])
+ assignment=np.minimum(np.arange(len(bank.donors))*4//len(bank.donors),3)
+ for age in (0,3):
+  j=s.lookback-1-age
+  for channel,name in enumerate(panel['target_names']):
+   y=bank.errors[:,j,channel]
+   valid=bank.support[:,j,channel]&bank.visible[:,j,channel]
+   x=xs[:,j,channel]
+   predicted=np.zeros_like(y); global_pred=np.zeros_like(y); nonlinear=np.zeros_like(y); boosted_ridge=np.zeros_like(y)
+   for block in range(4):
+    train=valid&(assignment!=block)[:,None]
+    xx,yy=x[train],y[train]
+    penalty=np.eye(x.shape[-1])*20; penalty[0,0]=1e-4
+    b=np.linalg.solve(xx.T@xx+penalty,xx.T@yy)
+    test=assignment==block
+    predicted[test]=x[test]@b
+    boosted_ridge[test]=predicted[test]
+    global_pred[test]=yy.mean() if len(yy) else 0
+    if len(yy)>=100:
+     model=HistGradientBoostingRegressor(max_iter=80,max_leaf_nodes=8,min_samples_leaf=50,l2_regularization=20,learning_rate=.05,random_state=42)
+     model.fit(xx[:,1:7],yy)
+     nonlinear[test]=model.predict(x[test,...,1:7].reshape(-1,6)).reshape(y[test].shape)
+     model.fit(xx[:,1:7],yy-xx@b)
+     boosted_ridge[test]+=model.predict(x[test,...,1:7].reshape(-1,6)).reshape(y[test].shape)
+   rows.append(dict(heldout_forecast_season=heldout,reporting_error_training_season=bank.donor_season,
+    signal=name,report_age_weeks=age,n=int(valid.sum()),mean_log_error=float(y[valid].mean()),
+    rms_log_error=float(np.sqrt(np.mean(y[valid]**2))),
+    blocked_cv_global_mean_rmse=float(np.sqrt(np.mean((y-global_pred)[valid]**2))),
+    blocked_cv_conditional_rmse=float(np.sqrt(np.mean((y-predicted)[valid]**2))),
+    blocked_cv_nonlinear_rmse=float(np.sqrt(np.mean((y-nonlinear)[valid]**2))),
+    blocked_cv_ridge_plus_boosted_rmse=float(np.sqrt(np.mean((y-boosted_ridge)[valid]**2))),
+    available_pairs_fraction=float(valid.mean())))
+frame=pd.DataFrame(rows)
+frame.to_csv(out/'nonlinear-reporting-blocked-validation.csv',index=False)
+print(frame.to_string(index=False))
+import matplotlib
+matplotlib.use('Agg')
+import matplotlib.pyplot as plt
+fig,axes=plt.subplots(1,2,figsize=(10,4.5),sharey=True)
+for ax,(season,g) in zip(axes,frame[(frame.report_age_weeks==0)&frame.signal.str.startswith('nhsn')].groupby('reporting_error_training_season')):
+ x=np.arange(len(g))
+ ax.plot(x,g.blocked_cv_nonlinear_rmse/g.blocked_cv_conditional_rmse,'o-',label='Standalone boosting / ridge')
+ ax.plot(x,g.blocked_cv_ridge_plus_boosted_rmse/g.blocked_cv_conditional_rmse,'s-',label='Ridge + boosted residual / ridge')
+ ax.axhline(1,color='gray',linestyle='--');ax.set_xticks(x,[n.replace('nhsn_','').replace('_admissions','') for n in g.signal])
+ ax.set_title('Archived reporting pairs from '+season);ax.grid(alpha=.2)
+axes[0].set_ylabel('Current-week admission log-error RMSE ratio\nBelow one improves on ridge')
+axes[0].legend(fontsize=8)
+fig.suptitle('Nonlinear final-to-report error generation: four contiguous-origin blocks\nTrain on three donor-season blocks, predict the fourth; no forecast retraining',fontsize=11)
+fig.tight_layout()
+fig.savefig(out/'nonlinear-reporting-blocked-validation.png',dpi=180)
+fig.savefig(out/'nonlinear-reporting-blocked-validation.pdf')

+s=replace(s,weekend_family='direct',supplied_final=False,mask_rate=0,reporting_missingness=False,reporting_augmentation='vintage')
+result=dict(applies_to='Pinned first-round v1 and admissions/dilution v2 generators; descriptive correction only, no fitted data or scores changed',
+ conditional_description_fields='Legacy conditional_model, ridge_penalty, residual_scale and centered-residual descriptions apply only when generator=ridge. Empirical generators use raw joint error windows with no fitted/subtracted conditional mean. Probability-zero controls apply no artificial errors.',
+ legacy_target_evidence_fraction='Final-truth support, NOT observed archived/final-pair support',
+ probability_zero_controls='Probability zero means no synthetic perturbation, regardless of legacy synthetic_seasons or recent_donor_inputs descriptions; early_actual still supplies real recent-season reports',
+ empirical_unsupported_cells='Zero empirical perturbation when donor archived/final pair is absent',
+ learned_unsupported_cells='Empirical residual zero when pair absent; conditional mean can extrapolate into those cells, so inherited unsupported_cells=unchanged is not valid for the learned generator',
+ truth_support='Final-truth availability is never invented. RSV admission inputs are absent in 2022-23.',
+ covariate_scope='C2 six-group covariate set; target support is shared by C1/C2/C3. C3 uses its Kinsa subset; C1 has no covariates.',
+ support_denominator='Donor origins x context ages x locations, within each signal; eligible reference weeks must belong to the permitted donor season',folds=[])

@@ -0,0 +1,133 @@
+"""Training-only conditional revision generation, dated overnight research protocol."""
+import numpy as np
+from . import cv
+from .episodes import episodes
+from .reporting_error import ReportingErrors, transport
+
+
+class VintageOvernight(ReportingErrors):
+    def __init__(self, panel, scenario, held_out, keep, corrections=None):
+        super().__init__(panel, scenario, held_out, keep, corrections)
+        self.signals = scenario.vintage_signals
+        self.scope = scenario.vintage_scope
+        self.generator = scenario.vintage_generator
+        self.residual_scale = scenario.vintage_residual
+        self.generator_probability = scenario.reporting_probability
+        if self.generator == "ridge":
+            self.probability = 1. # Gate the complete mean-plus-residual perturbation below.
+        self.panel = cv.masked(panel, keep)
+        self.actual_panel = panel
+        self.actual = {}
+        self.models = {}
+        self.means = {}
+        finals = {e['context_dates'][-1]: e for e in episodes(self.panel, scenario.lookback, 'scheduled_final', self.names)}
+        if self.generator == 'ridge':
+            donor = [finals[d] for d in self.donors]
+            for kind in ['target'] + (['covariate'] if self.names else []):
+                arr = self.errors if kind == 'target' else self.cov_errors
+                support = (self.support & self.visible) if kind == 'target' else (self.cov_support & self.cov_visible)
+                xs = np.stack([self.features_for(e, kind) for e in donor])
+                # X: origin, age, signal, location, feature. Fit each signal/age
+                # with a location effect shrunk toward the shared phase/calendar fit.
+                beta = np.zeros((*arr.shape[1:3], xs.shape[-1]))
+                predicted = np.zeros_like(arr)
+                for age in range(arr.shape[1]):
+                    for channel in range(arr.shape[2]):
+                        x = xs[:,age,channel].reshape(-1,xs.shape[-1])
+                        y = arr[:,age,channel].ravel()
+                        ok = support[:,age,channel].ravel()
+                        if ok.sum() < 30:
+                            continue
+                        xx, yy = x[ok], y[ok]
+                        penalty = np.eye(x.shape[-1]) * scenario.vintage_penalty
+                        penalty[0,0] = 1e-4
+                        b = np.linalg.solve(xx.T @ xx + penalty, xx.T @ yy)
+                        beta[age,channel] = b
+                        predicted[:,age,channel] = (x @ b).reshape(arr.shape[0],arr.shape[-1])
+                self.models[kind] = beta
+                # Center real donor windows; preserve their age/signal dependence.
+                residual = np.where(support, arr-predicted, 0)
+                if kind == 'target': self.errors = residual * self.residual_scale
+                else: self.cov_errors = residual * self.residual_scale
+        self.metadata.update(
+            target_final_truth_support_fraction=float(self.support.mean()),
+            target_archived_pair_support_fraction=float((self.support & self.visible).mean()),
+            target_archived_pair_fraction_given_final_truth=float((self.support & self.visible).sum()/self.support.sum()),
+            legacy_target_evidence_fraction='Alias for final-truth support; not archived-pair support',
+            support_denominator='All donor-origin, context-age, signal and location cells; archive pairs require both permitted final truth and observed reports',
+            unsupported_cells=('Empirical residuals are zero where archive pairs are absent, but the learned conditional mean can extrapolate into those cells; final-truth availability is never invented' if self.generator == 'ridge' else 'Empirical perturbations are zero where archive pairs are absent; final-truth availability is never invented'))
+        if self.names:
+            self.metadata.update(covariate_final_truth_support_fraction=float(self.cov_support.mean()),
+                covariate_archived_pair_support_fraction=float((self.cov_support & self.cov_visible).mean()))
+        self.metadata.update(generator=self.generator, augmentation_scope=self.scope, synthetic_signals=self.signals,
+            conditional_model=('Separate ridge per age and signal; finalized normalized level, preceding-week growth, origin growth, circular calendar, holiday proximity, shrunk location effects' if self.generator == 'ridge' else None),
+            ridge_penalty=scenario.vintage_penalty if self.generator == 'ridge' else None,
+            residual_scale=self.residual_scale if self.generator == 'ridge' else None,
+            residuals=('In-sample centered empirical joint windows; shrinkage retained; variance can be conservative' if self.generator == 'ridge' else 'Raw empirical joint error windows; no learned mean fitted or subtracted'),
+            recent_donor_inputs='Real Wednesday values on source schedule, absent-archive final proxies' if self.scope == 'early_actual' else 'Unchanged finalized inputs' if self.scope == 'early_clean' or scenario.reporting_probability == 0 else 'Synthetic inputs',
+            synthetic_seasons=[] if scenario.reporting_probability == 0 else ['2022-2023','2023-2024'] if self.scope != 'all' else sorted(self.peaks),
+            version='vintage_overnight_conditional_v2')
+
+    def features_for(self, e, kind):
+        label = cv.season(e['context_dates'][-1])
+        if kind == 'target':
+            v, valid, peak = e['values'], e['available'], self.peaks[label][0]
+        else:
+            v, valid, peak = e['covariates'][...,0,:], e['covariates'][...,1,:].astype(bool), self.cov_peak(label)
+        z = np.log(np.maximum(v,0)/np.maximum(peak[None],1e-8)+.05)
+        z = np.where(valid,z,np.log(.05))
+        growth = np.concatenate((np.zeros_like(z[:1]), np.diff(z,axis=0)),axis=0)
+        pairs = np.concatenate((np.zeros_like(valid[:1]), valid[1:] & valid[:-1]),axis=0)
+        growth = np.where(pairs,np.clip(growth,-3,3),0)
+        recent = np.broadcast_to(growth[-2:].mean(axis=0)[None],z.shape)
+        from .reporting_error import season_position
+        position = season_position(e['context_dates'][-1])
+        day = np.datetime64(e['context_dates'][-1])
+        year = int(str(day)[:4])
+        delta = min(abs(int((day-np.datetime64(f'{yr}-12-25')).astype(int))) for yr in (year-1,year,year+1))
+        constant = lambda a: np.full_like(z,a)
+        x = np.stack((constant(1),np.clip(z,-3,3),growth,recent,constant(np.sin(2*np.pi*position)),constant(np.cos(2*np.pi*position)),constant(np.exp(-.5*(delta/14)**2))),axis=-1)
+        identity = np.broadcast_to(np.eye(z.shape[-1]), (*z.shape,z.shape[-1]))
+        return np.concatenate((x,identity),axis=-1)
+
+    def draw(self, episode, rng):
+        season = cv.season(episode['context_dates'][-1])
+        if self.scope != 'all' and season not in ('2022-2023','2023-2024'):
+            if self.scope == 'early_actual':
+                from tapestry.experiment.weekend import scheduled_reports
+                key = (episode['context_dates'][-1], episode['available'].tobytes())
+                if key not in self.actual:
+                    self.actual[key] = scheduled_reports(episode, self.actual_panel, self.names)[0]
+                return dict(episode, **{k:self.actual[key][k] for k in ('values','available','known_final','covariates') if k in self.actual[key]})
+            return episode
+        if self.generator == "ridge" and self.generator_probability < 1 and rng.random() >= self.generator_probability:
+            return episode
+        out = super().draw(episode,rng)
+        if self.generator != 'ridge': return self.restrict(out,episode)
+        for kind,beta in self.models.items():
+            key = (kind,episode['context_dates'][-1],episode['available'].tobytes(),episode['covariates'][...,1,:].tobytes() if 'covariates' in episode else b'')
+            if key not in self.means:
+                self.means[key] = np.einsum('aslf,asf->asl',self.features_for(episode,kind),beta)
+            error = self.means[key].copy()
+            if self.recent: error[:-self.recent] = 0
+            error = np.clip(error,-np.log(4),np.log(4)) * self.strength
+            if kind == 'target':
+                v = transport(out['values'],error,self.target_floor(episode))
+                v[:,3:] = np.minimum(v[:,3:],1)
+                out['values'] = np.where(out['available'],v,0).astype(np.float32)
+            else:
+                for k,name in enumerate(self.names):
+                    if name in self.national_names and name not in self.state_names:
+                        error[:,k] = error[:,k,episode['locations'].index('US')][:,None]
+                cov = out['covariates'].copy()
+                v = transport(cov[...,0,:],error,np.maximum(.05*self.cov_peak(season)[None],1e-8))
+                cov[...,0,:] = np.where(cov[...,1,:],v,0)
+                out['covariates'] = cov
+        return self.restrict(out,episode)
+
+    def restrict(self,out,episode):
+        if self.signals == 'admissions':
+            out['values'][:,3:] = episode['values'][:,3:]
+            if 'covariates' in episode:
+                out['covariates'] = episode['covariates']
+        return out

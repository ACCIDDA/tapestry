+"""Native-unit nowcaster diagnostics alongside the shared forecasting score."""
+import csv
+import numpy as np
+from tapestry.dataset.cv import season
+
+def correction_diagnostics(truth, raw, corrected, weeks, held_out, output):
+    rows=[]
+    for age in range(weeks):
+        for k in range(6):
+            for geography in ('states_dc','US'):
+                loc=np.array([x=='US' for x in truth[0]['locations']])
+                if geography=='states_dc':loc=~loc
+                before=[];after=[]
+                for t,r,c in zip(truth,raw,corrected):
+                    if season(t['context_dates'][-1-age]) != held_out:continue
+                    ok=t['available'][-1-age,k]&r['available'][-1-age,k]&loc
+                    before.extend(abs(r['values'][-1-age,k,ok]-t['values'][-1-age,k,ok]))
+                    after.extend(abs(c['values'][-1-age,k,ok]-t['values'][-1-age,k,ok]))
+                if before:rows.append(dict(age=age,channel=k,geography=geography,cells=len(before),raw_mae=float(np.mean(before)),corrected_mae=float(np.mean(after))))
+    with (output/'nowcast_diagnostics.csv').open('w') as f:
+        w=csv.DictWriter(f,fieldnames=list(rows[0]));w.writeheader();w.writerows(rows)
+
+
+def evaluate_fixed(scenario, seed, held_out, members, device, output, dataset):
+    """Change only evaluation inputs of a saved clean-input forecast model."""
+    import torch
+    from pathlib import Path
+    from tapestry.model.scenario import Scenario
+    from tapestry.model.network import load_model,checkpoint
+    from tapestry.dataset import cv
+    from tapestry.dataset.build import load,covariate_names_for
+    from .weekend import scheduled_reports
+    from .training import evaluate
+    from .provenance import sha256,save
+    fp=Path(scenario.fixed_forecaster.format(seed=seed,season=held_out))
+    npth=Path(scenario.fixed_nowcaster.format(seed=seed,season=held_out)) if scenario.fixed_nowcaster!='raw' else None
+    saved=torch.load(fp,map_location='cpu',weights_only=False);original=saved['metadata']
+    source=Scenario.from_string(original['scenario'])
+    if original['seed']!=seed or original['held_out_season']!=held_out or original['dataset_sha256']!=sha256(dataset):
+        raise ValueError('Fixed forecast checkpoint differs in seed, season, or dataset')
+    if source.weekend_family!='direct' or source.reporting_probability!=0:
+        raise ValueError('Expected a clean-input-trained direct forecaster')
+    for name in ['fit_partition','spatial','covariate_set','lookback','mask_rate']:
+        if getattr(source,name)!=getattr(scenario,name):raise ValueError(f'Architecture mismatch: {name}')
+    corrector=torch.load(npth,map_location='cpu',weights_only=False)['final'] if npth else None
+    permitted={'2022-2023','2023-2024','2024-2025','2025-2026'}-{held_out}
+    if corrector and set(corrector.training_seasons)!=permitted:raise ValueError('Nowcaster trajectory seasons differ from permitted training split')
+    panel=load(dataset);fold=cv.fold(panel,source,held_out)
+    raw=[scheduled_reports(e,panel,list(covariate_names_for(source.covariate_set)))[0] for e in fold.score]
+    correction_scenario=None;corrector_error_record=None;uncertainty_record=None
+    if corrector:
+        import pandas as pd
+        design=pd.read_csv(npth.parents[4]/'design.csv')
+        selected=design[design.run_id.eq(npth.parents[3].name)]
+        if len(selected)!=1:raise ValueError('Nowcaster source recipe is ambiguous')
+        import json
+        source_manifest=npth.parent/'manifest.json'
+        source_metadata=json.loads(source_manifest.read_text()) if source_manifest.exists() else {}
+        correction_scenario=Scenario.from_string(source_metadata.get('corrector_source_scenario') or selected.iloc[0].scenario)
+        correction_fold=cv.fold(panel,correction_scenario,held_out)
+        correction_truth=correction_fold.score
+        template=corrector
+        if scenario.fixed_refit_nowcaster:
+            from dataclasses import replace
+            correction_scenario=replace(correction_scenario,correction_observed_pairs_only=scenario.correction_observed_pairs_only)
+            if scenario.fixed_nowcaster_covariates=='none':
+                correction_scenario=replace(correction_scenario,covariate_set='')
+                correction_fold=cv.fold(panel,correction_scenario,held_out)
+                correction_truth=correction_fold.score
+            from .weekend import fit_correctors
+            from tapestry.dataset.reporting_error import ReportingErrors
+            roles=cv.week_roles(panel['dates'],correction_scenario,held_out)
+            errors=ReportingErrors(panel,correction_scenario,held_out,np.isin(roles,['fit','validation']))
+            cross,corrector=fit_correctors(correction_fold.train,errors,correction_scenario,seed)
+            corrector_error_record=errors.metadata
+            if set(corrector.training_seasons)!=permitted:raise ValueError('Refitted nowcaster leaked a trajectory season')
+            Path(output).mkdir(parents=True,exist_ok=True)
+            # Save the final estimator after setting its applied correction strength below.
+        by_date={e['context_dates'][-1]:e for e in correction_truth}
+        correction_raw=[scheduled_reports(by_date[e['context_dates'][-1]],panel,list(covariate_names_for(correction_scenario.covariate_set)))[0] for e in fold.score]
+        for x,y in zip(raw,correction_raw):
+            for key in ['values','available','context_dates','locations']:
+                np.testing.assert_array_equal(x[key],y[key],err_msg=f'Nowcaster/forecaster input mismatch: {key}')
+        if scenario.fixed_refit_nowcaster and seed==42 and not scenario.correction_observed_pairs_only and scenario.fixed_nowcaster_covariates=='source':
+            old=template.apply_batch(correction_raw[:2]) if hasattr(template,'apply_batch') else [template.apply(e) for e in correction_raw[:2]]
+            new=corrector.apply_batch(correction_raw[:2]) if hasattr(corrector,'apply_batch') else [corrector.apply(e) for e in correction_raw[:2]]
+            for x,y in zip(old,new):np.testing.assert_allclose(x['values'],y['values'],rtol=1e-6,atol=1e-6,err_msg='Refit differs from seed42 source nowcaster')
+        if scenario.fixed_refit_nowcaster:
+            corrector.strength=scenario.correction_strength
+            torch.save(dict(final=corrector),Path(output)/'nowcast_correctors.pt')
+        estimates=corrector.apply_batch(correction_raw) if hasattr(corrector,'apply_batch') else [corrector.apply(e) for e in correction_raw]
+        # Only target histories change. The forecast model keeps its own covariates.
+        corrected=[dict(x,values=y['values']) for x,y in zip(raw,estimates)]
+    else:corrected=raw
+    if scenario.fixed_correction_channels=='admissions':
+        corrected=[dict(y,values=np.concatenate((y['values'][:,:3],x['values'][:,3:]),axis=1)) for x,y in zip(raw,corrected)]
+    for x,y in zip(raw,corrected):
+        for key in ['target_values','target_available','target_dates','available']:
+            np.testing.assert_array_equal(x[key],y[key],err_msg=f'Correction changed {key}')
+    if scenario.fixed_history_mode=='crossfit_residual':
+        corrected,uncertainty_record=crossfit_residual_histories(correction_fold.train,errors,cross,corrector,correction_raw,corrected,members,seed,scenario.fixed_uncertainty_strength,scenario.fixed_correction_channels)
+    elif scenario.fixed_history_mode!='none':
+        if scenario.fixed_history_mode=='raw_full_mixture' and (corrector is None or corrector.strength!=1 or members%2):
+            raise ValueError('Raw/full mixture needs a full-strength corrector and even member count')
+        for x,y in zip(raw,corrected):
+            bank=np.broadcast_to(y['values'],(members,*y['values'].shape)).copy()
+            if scenario.fixed_history_mode=='raw_full_mixture':
+                # One global hypothesis per draw preserves cross-target/location/week coherence.
+                # Alternate hypotheses to balance every sampling chunk; this is a sensitivity
+                # distribution, not an empirically calibrated posterior.
+                bank[::2]=x['values']
+                np.testing.assert_array_equal(bank[0],x['values'])
+                np.testing.assert_array_equal(bank[1],y['values'])
+            y['history_samples']=bank
+    out=Path(output);out.mkdir(parents=True,exist_ok=True)
+    model=load_model(saved).to(device)

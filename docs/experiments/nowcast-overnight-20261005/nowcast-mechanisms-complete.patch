+def crossfit_residual_histories(train,errors,cross,corrector,reported,centers,members,seed,strength,channels='all'):
+    """Bootstrap intact out-of-season synthetic revision residual trajectories.
+
+    This uncertainty is learned from permitted training data, not calibrated on
+    evaluation labels. Median centering preserves the chosen point correction.
+    """
+    from tapestry.dataset.cv import season
+    rng=np.random.default_rng(seed+420000)
+    residuals=[];donor_seasons=[]
+    indices=np.arange(-1,-corrector.weeks-1,-1)
+    for label,model in cross.items():
+        if label in model.training_seasons:raise ValueError('Residual estimator saw its trajectory season')
+        truths=[e for e in train if season(e['context_dates'][-1])==label for _ in range(2)]
+        raw=[errors.draw(e,rng) for e in truths]
+        estimates=model.apply_batch(raw)
+        for x,y,t in zip(raw,estimates,truths):
+            floor=np.stack([model.design(x,k)[1] for k in range(6)])
+            ok=x['available'][indices]&t['available'][indices]
+            # Context may cross a season boundary: retain only this held-out
+            # trajectory season's labels, never in-season fitted residuals.
+            ok &= np.array([season(x['context_dates'][i])==label for i in indices])[:,None,None]
+            z=np.log((t['values'][indices]+floor)/(y['values'][indices]+floor))
+            residuals.append(np.where(ok,np.clip(z,-np.log(4),np.log(4)),np.nan))
+            donor_seasons.append(label)
+    bank=np.stack(residuals);support=np.isfinite(bank)
+    counts={s:donor_seasons.count(s) for s in set(donor_seasons)}
+    weights=np.array([1./counts[s] for s in donor_seasons]);weights/=weights.sum()
+    order=np.argsort(np.where(support,bank,np.inf),axis=0)
+    sorted_bank=np.take_along_axis(bank,order,axis=0)
+    cell_weights=np.where(support,weights[:,None,None,None],0.)
+    cumulative=np.cumsum(np.take_along_axis(cell_weights,order,axis=0),axis=0)
+    median_index=(cumulative<.5*cumulative[-1]).sum(0).clip(0,len(bank)-1)
+    median=np.take_along_axis(sorted_bank,median_index[None],axis=0)[0]
+    noise=np.nan_to_num(np.where(support,bank-median,0.))
+    out=[]
+    for x,c in zip(reported,centers):
+        issue=int(np.datetime64(x['context_dates'][-1],'D').astype(int))
+        chosen=np.random.default_rng(seed+430000+issue).choice(len(bank),size=members,p=weights)
+        histories=np.broadcast_to(c['values'],(members,*c['values'].shape)).copy()
+        floor=np.stack([corrector.design(x,k)[1] for k in range(6)])
+        values=np.maximum(0,(c['values'][indices]+floor)*np.exp(strength*noise[chosen])-floor)
+        values[:,:,3:]=np.minimum(1,values[:,:,3:])
+        if channels=='admissions':values[:,:,3:]=c['values'][indices,3:]
+        histories[:,indices]=np.where(x['available'][indices],values,0.)
+        # Earlier history, availability and finalized future labels are unchanged.
+        np.testing.assert_array_equal(histories[:,:-corrector.weeks],np.broadcast_to(c['values'][:-corrector.weeks],histories[:,:-corrector.weeks].shape))
+        out.append(dict(c,history_samples=histories))
+    record=dict(method='Intact cross-fitted synthetic log-revision residual bootstrap; cellwise median centered; seasons sampled equally',
+        donor_trajectory_seasons=sorted(counts),donors=len(bank),supported_fraction=float(support.mean()),
+        noise_strength=strength,point_correction_strength=corrector.strength,channels=channels,
+        labels='Final recent histories from permitted training seasons only; each residual predictor excluded its trajectory season',
+        calibration='Synthetic training residual distribution; no evaluation-season fitting or posterior-calibration claim')
+    return out,record

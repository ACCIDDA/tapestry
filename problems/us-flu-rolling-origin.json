{
  "schema_version": 1,
  "id": "us-flu-rolling-origin",
  "dataset": "../datasets/respiratory-us-weekly.json",
  "targets": ["nhsn_flu_admissions", "nssp_flu_proportion"],
  "forecast": {"horizons": [1, 2, 3, 4]},
  "folds": {
    "kind": "rolling_origin",
    "ids": ["2024-25-winter", "2025-26-winter"],
    "periods": {
      "2024-25-winter": ["2024-10-05", "2025-05-31"],
      "2025-26-winter": ["2025-10-04", "2026-05-30"]
    }
  },
  "evaluation": {
    "kind": "weekly_quantile_wis",
    "inputs": "finalized",
    "draws": 1,
    "primary": {"target": "nhsn_flu_admissions", "scale": "log", "geography": "states_dc"}
  },
  "comparison": {"kind": "none"}
}
